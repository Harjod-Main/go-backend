# Server
ENV=LOCAL
HOSTNAME=localhost
PORT=8080
# Trusted proxy CIDRs for ClientIP / rate limiting (comma-separated).
# LOCAL: leave empty (defaults to loopback). PROD: required — use your LB ingress CIDR only.
# Do NOT use broad RFC1918 (10/8, 172.16/12, 192.168/16) on shared NAT/LB — allows X-Forwarded-For spoofing.
# TRUSTED_PROXY_CIDRS=10.0.0.1/32
# Temporary: GET /debug/client-ip on LOCAL/DEV/UAT only (refused in PROD).
# ENABLE_DEBUG_CLIENT_IP=true

# Access Control
# LOCAL only: * is fine (auth uses Bearer tokens, not cookies).
# PROD/UAT: set the exact frontend origin(s), e.g.
# ACCESS_CONTROL_ALLOW_ORIGIN=https://frontend-statio-s-projects.vercel.app
# Server refuses ACCESS_CONTROL_ALLOW_ORIGIN=* when ENV=PROD.
ACCESS_CONTROL_ALLOW_ORIGIN=*

# Header
REF_ID_HEADER_KEY=X-Ref-Id

# Supabase (required for Harjod foundation)
# Project URL example: https://xxxx.supabase.co
SUPABASE_PROJECT_URL=
# Audience for user access tokens (ES256 via JWKS only — no HS256 shared secret)
SUPABASE_JWT_AUDIENCE=authenticated

# Postgres / Supabase DB (required for places API; server pings pool at boot)
# Prefer pooler (IPv4). Example for this project region:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Or discrete fields (Direct host may be IPv6-only):
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require
SECRET_DB_USER=postgres
SECRET_DB_PASSWORD=
